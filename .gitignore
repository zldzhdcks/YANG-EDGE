# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Local proto-round operator inbox (legacy layout; raw screenshots + local manifests).
# Do not whitelist screenshots. All files under this root stay untracked.
/PROTO_ROUNDS/

# Active operator screenshot root if it is ever placed inside this git repo.
# The live root is normally a sibling: ../YANG-EDGE-INBOX
/YANG-EDGE-INBOX/

# Research raw provider caches (regenerable; do not commit)
# Tracked caches under data/cache/mlb-game-results/ are NOT covered here.
/data/cache/research/mlb/raw/
/data/cache/research/kbo/raw/
/data/cache/research/football/historical-archive-v1/
/data/cache/research/football/forward-shadow-v1/
/data/cache/research/football/poisson-chronological-backtest-v1/
/data/cache/research/football/poisson-v2-draw-research/
/data/cache/research/mlb/derived/
/data/cache/research/mlb/operator-collection/
/data/cache/research/football/operator-collection/
/data/research/mlb/sealed-pregame/
/data/audits/operational/

# Mutable Odds API quota receipt — runtime operational state, not a Git artifact.
/data/ops/provider/the-odds-api/quota-receipt-v1.json

# Mac operations node runtime state (mutex + health). Not research evidence.
/data/ops/locks/mac-operations-node-v1.lock
/data/ops/locks/mac-operations-node-v1.recovery.lock
/data/ops/health/mac-operations-node-v1.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Round 111 acquisition payloads and runtime caches stay local; explicit evidence packs are tracked.
/data/cache/research/round-111-priority-identity/
/data/cache/research/round-111-v1-inputs/
/data/research/slate-batches/*/data/cache/
.next-owner-preview/
