<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  YANG EDGE Mac operations node — NON-ACTIVE LaunchDaemon TEMPLATE.

  DO NOT load this file.
  DO NOT copy guessed local paths.
  DO NOT put secrets or API keys here.

  Future install rehearsal will substitute placeholders:

  Label
  ProgramArguments = [<ABSOLUTE_NODE>, <REPO>/node_modules/tsx/dist/cli.mjs, <REPO>/scripts/run-mac-operations-node-v1.ts, --run]
  WorkingDirectory = <REPO>
  StandardOutPath
  StandardErrorPath
  StartInterval = 300  (5 minutes)
  RunAtLoad = true
  UserName  (LaunchDaemon)

  Recommended mode: LaunchDaemon + explicit UserName.
  Never use npx or Homebrew PATH aliases.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yang-edge.mac-operations-node-v1</string>
  <key>UserName</key>
  <string>__YANG_EDGE_USERNAME__</string>
  <key>WorkingDirectory</key>
  <string>__YANG_EDGE_REPO_ROOT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__YANG_EDGE_ABSOLUTE_NODE__</string>
    <string>__YANG_EDGE_REPO_ROOT__/node_modules/tsx/dist/cli.mjs</string>
    <string>__YANG_EDGE_REPO_ROOT__/scripts/run-mac-operations-node-v1.ts</string>
    <string>--run</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__YANG_EDGE_LOG_DIR__/mac-operations-node-v1.out.log</string>
  <key>StandardErrorPath</key>
  <string>__YANG_EDGE_LOG_DIR__/mac-operations-node-v1.err.log</string>
</dict>
</plist>
