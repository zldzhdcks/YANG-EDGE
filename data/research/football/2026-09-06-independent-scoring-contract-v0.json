  "metrics": [
    {
      "id": "CONTEXT_WIN_RATE",
      "home": {
        "numerator": "fixtures.wins.home",
        "denominator": "fixtures.played.home",
        "formula": "homeWins / homeFixturesPlayed"
      },
      "away": {
        "numerator": "fixtures.wins.away",
        "denominator": "fixtures.played.away",
        "formula": "awayWins / awayFixturesPlayed"
      }
    },
    {
      "id": "CONTEXT_GOAL_DIFFERENCE_PER_GAME",
      "home": {
        "goalsFor": "goals.for.total.home",
        "goalsAgainst": "goals.against.total.home",
        "denominator": "fixtures.played.home",
        "formula": "(homeGoalsFor - homeGoalsAgainst) / homeFixturesPlayed"
      },
      "away": {
        "goalsFor": "goals.for.total.away",
        "goalsAgainst": "goals.against.total.away",
        "denominator": "fixtures.played.away",
        "formula": "(awayGoalsFor - awayGoalsAgainst) / awayFixturesPlayed"
      }
    }
  ],
  "decisionRule": {
    "id": "STRICT_BOTH_METRICS_DOMINANCE",
