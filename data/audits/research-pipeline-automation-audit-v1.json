  "automationCandidates": [
    {
      "id": "AC-01",
      "title": "npm script aliases for common research commands",
      "steps": ["starter-accumulation", "postgame-pipeline", "bullpen-validate", "lineup-dataset", "coverage-dashboard"],
      "risk": "low",
      "rationale": "Reduces copy-paste errors; no execution logic change"
    },
    {
      "id": "AC-02",
      "title": "run-mlb-research-ops-pipeline.ts (read-only chain)",
      "steps": ["dataset-correlation-audit", "contradiction-ledger", "contradiction-severity", "coverage-dashboard"],
      "risk": "low",
      "rationale": "All read existing artifacts; safe to chain after datasets exist",
      "dependsOn": ["postgame-pipeline", "starter-accumulation", "bullpen-dataset-v1_1", "lineup-dataset"]
    },
    {
      "id": "AC-03",
      "title": "Extend run-mlb-postgame-pipeline with optional flags",
      "steps": ["starter-accumulation postgame", "bullpen-validate", "lineup-dataset"],
      "risk": "medium",
      "rationale": "Eliminates duplicate grade/review runs between postgame and bullpen-validate",
      "caveat": "Must preserve prediction hash checks; slate must be Final"
    },
    {
      "id": "AC-04",
      "title": "Pre-game orchestrator after snapshot",
      "steps": ["starter-accumulation pre-game", "bullpen-dataset-v1_1"],
      "risk": "medium",
      "rationale": "Both depend on frozen prediction snapshot only",
      "caveat": "Snapshot freeze must remain separate human gate"
    },
    {
      "id": "AC-05",
      "title": "summarize-mlb-starter-accumulation after each accumulation run",
      "steps": ["starter-accumulation-summary"],
      "risk": "low",
      "rationale": "Pure aggregation; no Engine impact"
    },
    {
      "id": "AC-06",
      "title": "Wire refresh-site-feedback-learning into postgame (already partial)",
      "steps": ["postgame-pipeline"],
      "risk": "low",
      "rationale": "Already in run-mlb-postgame-pipeline; document as canonical last postgame step"
    }
  ],
