        "minSampleSize": 4,
        "maxAvgOutsExclusive": 4,
        "basis": "avgOuts<=4.5가 LONG(>=4)과 겹침. MIDDLE 상한을 avgOuts<4로 내리고 score를 LONG과 분리해야 함"
      },
