      },
      "OPENER": {
        "minShortStarts": 3,
        "basis": "현재 n>=2 + short rate>=0.5 → 표본 2로도 OPENER. 분포상 5명뿐이라 최소 3회로 상향 제안"
      },
      "MOP_UP": {
        "minBlowoutEntries": 3,
        "basis": "코드가 이미 n>=3 & mopRate>=0.5 — 유지. 다만 mopRate 분모가 entry 없으면 왜곡"
      },
